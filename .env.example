# -- Azure OpenAI ---------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TEMPERATURE=0

# -- Agent profile ---------------------------------------------------------------
# Selects which profile to load from profiles/<name>/ (rules, examples, config)
# Options: client | tpcds | bird
AGENT_PROFILE=tpcds

# -- Agent settings --------------------------------------------------------------
MAX_SCHEMA_ITERATIONS=6
ROW_LIMIT=20

# -- Database backend (optional override - defaults to active profile's setting) -
# Options: duckdb | sqlite | synapse
DB_BACKEND=duckdb

# -- Azure Synapse (required only when DB_BACKEND=synapse) -----------------------
SYNAPSE_SERVER=your-workspace.sql.azuresynapse.net,1433
SYNAPSE_DATABASE=your_database_name
SYNAPSE_SCHEMA=curated

SYNAPSE_AUTH=ActiveDirectoryServicePrincipal
CLIENT_ID=your-app-registration-client-id
CLIENT_SECRET=your-client-secret-value
TENANT_ID=your-azure-tenant-id

# -- LangSmith (optional - tracing and observability) ----------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=sql-agent
